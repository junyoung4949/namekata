# 바깥에서 들어오는 유일한 문.
#
# SITE_ADDRESS 가 도메인이면 Caddy 가 Let's Encrypt 인증서를 자동으로 받고
# 갱신까지 한다. 값이 ":80" 이면 (도메인 없이 IP 로 접속) 평문으로 받는다.
#
# 들어오는 것을 셋으로 나눈다. 셋의 보호 방법이 다르다.

{$SITE_ADDRESS} {
	encode gzip zstd

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}

	# ── 1. 기계가 부르는 창구 ────────────────────────────────────────────
	#
	# GitHub Actions 의 추출 워크플로가 /admin/questions/pins 로 커밋을 받고
	# /admin/questions/import 로 결과를 보낸다. Spring 으로 바로 넘긴다.
	#
	# 이 블록이 아래 handle 보다 먼저라 basic_auth 를 타지 않는다. 기계가
	# 부르는 길이라 토큰으로 막는 것이 맞다. 다만 가이드 slug 를 'questions'
	# 로 지으면 편집 화면이 여기로 샌다 — 그 이름은 쓰지 않는다.
	#
	# 토큰이 막는다 (server 의 naming... 아니 admin.AdminGuard). 상수 시간
	# 비교를 쓰고, 운영 프로파일에서 토큰 없이 뜨면 시작을 거부하므로 "토큰을
	# 안 채운 채 열려 있는" 상태가 될 수 없다.
	handle /admin/questions/* {
		reverse_proxy server:8080
	}

	handle {
		# ── 2. 사람이 보는 편집 화면 ──────────────────────────────────
		#
		# 여기에는 **정답이 들어 있고**, 가이드를 고칠 수 있다. 그런데 Next 의
		# 서버 컴포넌트가 서버 쪽 토큰으로 불러오기 때문에 페이지 자체는 "누가
		# 보는지" 를 확인하지 않는다. 그대로 공개하면 들어온 아무나 전체
		# 정답을 보고 글을 고친다.
		#
		# 쓰는 동작은 서버 액션이고, 그것도 보고 있는 주소(/admin/...)로
		# POST 된다. 그래서 이 한 줄이 읽기와 쓰기를 함께 막는다.
		#
		# 경로가 /ko/admin, /en/admin 이었다. i18n 을 걷어내면서 /admin 으로
		# 옮겨왔는데 여기를 안 고쳤으면 편집기가 통째로 열린 채 배포됐다.
		@adminUI path /admin /admin/*
		basic_auth @adminUI {
			{$ADMIN_USER} {$ADMIN_PASSWORD_HASH}
		}

		# ── 3. 나머지 전부 ────────────────────────────────────────────
		#
		# Next 의 정적 자산은 파일 이름에 해시가 붙어 있어서 영구 캐시해도
		# 된다. 반대로 페이지 HTML 은 절대 캐시하지 않는다 — 문제·집계·검수
		# 상태가 들어 있다.
		@static path /_next/static/* /icon.svg /favicon.ico
		header @static Cache-Control "public, max-age=31536000, immutable"

		reverse_proxy web:3000
	}

	log {
		output stdout
		format console
	}
}
