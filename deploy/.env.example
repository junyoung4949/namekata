# 실제 값은 .env 에 넣는다. .env 는 커밋하지 않는다 (.gitignore 확인).
#
#   cp .env.example .env && nano .env

# Postgres 비밀번호. 이 박스 안에서만 쓰이지만(포트를 밖으로 열지 않는다)
# 길게 둔다. 만들기: openssl rand -base64 24
DB_PASSWORD=

# 검수·import API 를 지키는 토큰. GitHub Actions 시크릿의
# NAMEKATA_ADMIN_TOKEN 과 **같은 값**이어야 추출 워크플로가 통과한다.
# 만들기: openssl rand -hex 32
ADMIN_TOKEN=

# 도메인이 있으면 적는다 (예: namekata.dev). Caddy 가 인증서를 자동으로
# 받아 HTTPS 로 띄운다. 없으면 ":80" 그대로 두고 IP 로 접속한다.
SITE_ADDRESS=:80

# 삭제 요청 창구. 비워 두면 코드의 기본값(about4949@gmail.com)이 쓰인다.
TAKEDOWN_CONTACT=

# 검수 화면(/ko/admin)을 가리는 비밀번호. 그 화면에는 정답이 들어 있고,
# Next 서버 컴포넌트가 서버 토큰으로 불러오기 때문에 페이지 자체는 누가
# 보는지 확인하지 않는다. Caddy 가 읽기부터 막는다.
#
# 해시 만들기:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext '비밀번호'
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=

# Google Analytics 4 측정 ID (G-XXXXXXXXXX). 비우면 GA 가 아예 안 실린다.
#
# 주의: 브라우저로 나가는 값이라 **빌드할 때** 번들에 박힌다. 바꾼 뒤에는
#       docker compose build web 을 다시 해야 반영된다.
GA_ID=
