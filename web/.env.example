# Spring Boot 서버 주소. 반드시 있어야 한다 — 문제·제출·검수가 전부 서버에서 온다.
NAMEKATA_API_URL=http://localhost:8080

# 검수 화면의 승인/거부 API 보호. 서버의 NAMEKATA_ADMIN_TOKEN 과 같은 값이어야 한다.
# 비어 있으면 개발 환경에서만 열리고, 운영에서는 401이 난다.
NAMEKATA_ADMIN_TOKEN=

# 검수 전 문제도 보인다는 안내 문구를 띄울지.
#
# 거르는 일은 서버가 한다 (namekata.allow-pending). 이 값은 문구만 정한다 —
# 두 곳에서 같은 결정을 내리면 어긋났을 때 데이터와 화면이 다른 말을 한다.
NAMEKATA_ALLOW_PENDING=0

# 삭제 요청 창구 주소.
NEXT_PUBLIC_TAKEDOWN_CONTACT=
